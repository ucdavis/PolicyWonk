{
  "name": "PolicyWonk Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.formatting.provider": "autopep8",
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "always"
        },
        "editor.formatOnSave": true,
        "eslint.workingDirectories": [
          "./web"
        ]
      }
    }
  },
  "postCreateCommand": "sudo chown -R \"$(id -u):$(id -g)\" /workspace/web/node_modules && cd /workspace/web && npm ci --include=optional && node -e \"require('lightningcss')\"",
  "mounts": [
    // Mount to persist Playwright's browser cache
    "source=playwright-cache,target=/root/.cache/ms-playwright,type=volume"
  ],
  "containerEnv": {
    "VIRTUAL_ENV": "/home/vscode/.venv"
  },
  "remoteEnv": {
    "PYTHONPATH": "/workspace/backend",
    "PATH": "/home/vscode/.venv/bin:${containerEnv:PATH}"
  }
}
